rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function userRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }
    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active";
    }
    function hasRole(role) { return activeUser() && userRole() == role; }
    function isAdmin() { return hasRole("admin"); }
    function isOrganizationAdmin(organizationId) {
      return hasRole("organization")
        && exists(/databases/$(database)/documents/organizationMembers/$(organizationId + "_" + request.auth.uid))
        && get(/databases/$(database)/documents/organizationMembers/$(organizationId + "_" + request.auth.uid)).data.role == "owner";
    }
    function isVerifiedOrganization(organizationId) {
      return exists(/databases/$(database)/documents/organizations/$(organizationId))
        && get(/databases/$(database)/documents/organizations/$(organizationId)).data.status == "verified";
    }
    function publicOpportunity(data) { return data.status == "published" && data.visibility == "public"; }
    function validOrganizationAreas(data) {
      return data.areas is list
        && data.areas.size() <= 8
        && data.areas.hasOnly([
          "Ambiente", "Educación", "Deporte y recreación", "Arte y cultura",
          "Alimentación", "Asistencia comunitaria", "Salud y bienestar", "Tecnología y comunicación"
        ]);
    }
    function verifiedSkillsAdvance(previous, next, selected) {
      return selected.hasOnly([
          "Arte y creatividad", "Educación y acompañamiento", "Naturaleza y ambiente",
          "Cocina y alimentación", "Construcción y reparación", "Organización y logística",
          "Tecnología y comunicación", "Deporte, juego y recreación"
        ])
        && next.diff(previous).affectedKeys().hasOnly(selected)
        && next.get("Arte y creatividad", 0) == previous.get("Arte y creatividad", 0) + (selected.hasAny(["Arte y creatividad"]) ? 1 : 0)
        && next.get("Educación y acompañamiento", 0) == previous.get("Educación y acompañamiento", 0) + (selected.hasAny(["Educación y acompañamiento"]) ? 1 : 0)
        && next.get("Naturaleza y ambiente", 0) == previous.get("Naturaleza y ambiente", 0) + (selected.hasAny(["Naturaleza y ambiente"]) ? 1 : 0)
        && next.get("Cocina y alimentación", 0) == previous.get("Cocina y alimentación", 0) + (selected.hasAny(["Cocina y alimentación"]) ? 1 : 0)
        && next.get("Construcción y reparación", 0) == previous.get("Construcción y reparación", 0) + (selected.hasAny(["Construcción y reparación"]) ? 1 : 0)
        && next.get("Organización y logística", 0) == previous.get("Organización y logística", 0) + (selected.hasAny(["Organización y logística"]) ? 1 : 0)
        && next.get("Tecnología y comunicación", 0) == previous.get("Tecnología y comunicación", 0) + (selected.hasAny(["Tecnología y comunicación"]) ? 1 : 0)
        && next.get("Deporte, juego y recreación", 0) == previous.get("Deporte, juego y recreación", 0) + (selected.hasAny(["Deporte, juego y recreación"]) ? 1 : 0);
    }

    match /users/{userId} {
      allow create: if owns(userId) && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "active"
        && (
          request.resource.data.role in ["volunteer", "organization"]
          || (request.resource.data.role == "admin" && request.auth.token.email == "leybatao014@gmail.com")
        );
      allow read: if owns(userId) || isAdmin();
      allow update: if (
        owns(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "lastLoginAt"])
      ) || (
        owns(userId)
        && resource.data.status == "active"
        && request.resource.data.status == "active"
        && resource.data.role in ["volunteer", "organization"]
        && request.resource.data.role in ["volunteer", "organization"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "updatedAt"])
        && exists(/databases/$(database)/documents/organizations/$(userId))
        && exists(/databases/$(database)/documents/organizationMembers/$(userId + "_" + userId))
      ) || (
        owns(userId)
        && resource.data.status == "suspended"
        && resource.data.suspendedUntil < request.time
        && request.resource.data.status == "active"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "suspensionReason", "suspendedUntil", "lastLoginAt", "updatedAt"])
      ) || (
        owns(userId)
        && request.auth.token.email == "leybatao014@gmail.com"
        && request.resource.data.role == "admin"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "lastLoginAt"])
      ) || (
        isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName", "role", "status", "suspensionReason", "suspendedUntil", "moderatedBy", "updatedAt"
        ])
      );
    }

    match /volunteerProfiles/{userId} {
      allow create: if owns(userId)
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.role == "volunteer"
        && request.resource.data.completedExperiences == 0
        && request.resource.data.verifiedHours == 0
        && request.resource.data.verifiedSkills == {}
        && request.resource.data.experiences == []
        && request.resource.data.keys().hasOnly([
          "name", "initials", "location", "bio", "completedExperiences", "verifiedHours",
          "interests", "declaredSkills", "verifiedSkills", "availability", "socialLinks",
          "experiences", "visibleToOrganizations", "visibleToVolunteers", "updatedAt"
        ]);
      allow read: if owns(userId) || isAdmin()
        || (hasRole("organization") && resource.data.visibleToOrganizations == true)
        || (hasRole("volunteer") && resource.data.visibleToVolunteers == true);
      allow update: if (
        owns(userId) && activeUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "initials", "location", "bio", "interests", "declaredSkills", "availability", "socialLinks", "visibleToOrganizations", "visibleToVolunteers", "updatedAt"
        ])
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "verifiedSkills", "experiences", "completedExperiences", "lastExperienceMatchId", "updatedAt"
        ])
        && getAfter(/databases/$(database)/documents/matches/$(request.resource.data.lastExperienceMatchId)).data.userId == userId
        && getAfter(/databases/$(database)/documents/matches/$(request.resource.data.lastExperienceMatchId)).data.status == "completed"
        && isOrganizationAdmin(getAfter(/databases/$(database)/documents/matches/$(request.resource.data.lastExperienceMatchId)).data.organizationId)
        && request.resource.data.lastExperienceMatchId != resource.data.get("lastExperienceMatchId", "")
        && request.resource.data.completedExperiences == resource.data.completedExperiences + 1
        && request.resource.data.experiences.size() == resource.data.experiences.size() + 1
        && getAfter(/databases/$(database)/documents/feedback/$(request.resource.data.lastExperienceMatchId)).data.matchId == request.resource.data.lastExperienceMatchId
        && getAfter(/databases/$(database)/documents/feedback/$(request.resource.data.lastExperienceMatchId)).data.volunteerId == userId
        && getAfter(/databases/$(database)/documents/feedback/$(request.resource.data.lastExperienceMatchId)).data.organizationId == getAfter(/databases/$(database)/documents/matches/$(request.resource.data.lastExperienceMatchId)).data.organizationId
        && getAfter(/databases/$(database)/documents/feedback/$(request.resource.data.lastExperienceMatchId)).data.skills.size() <= 3
        && verifiedSkillsAdvance(
          resource.data.verifiedSkills,
          request.resource.data.verifiedSkills,
          getAfter(/databases/$(database)/documents/feedback/$(request.resource.data.lastExperienceMatchId)).data.skills
        )
      );
    }

    match /organizations/{organizationId} {
      allow read: if resource.data.status == "verified" || owns(resource.data.ownerId) || isOrganizationAdmin(organizationId) || isAdmin();
      allow create: if owns(organizationId)
        && getAfter(/databases/$(database)/documents/users/$(organizationId)).data.role == "organization"
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "pending"
        && validOrganizationAreas(request.resource.data);
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "name", "province", "location", "contact", "description", "areas", "status", "moderationReason",
        "imageUrl", "socialLinks", "moderatedBy", "moderatedAt", "updatedAt"
      ])) || (activeUser() && owns(resource.data.ownerId) && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "name", "province", "location", "contact", "description", "areas", "imageUrl", "socialLinks", "updatedAt"
      ]) && validOrganizationAreas(request.resource.data));
    }

    match /organizationMembers/{membershipId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOrganizationAdmin(resource.data.organizationId));
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.organizationId == request.auth.uid
        && request.resource.data.role == "owner"
        && membershipId == request.resource.data.organizationId + "_" + request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid;
    }

    match /opportunities/{opportunityId} {
      allow read: if publicOpportunity(resource.data) || isOrganizationAdmin(resource.data.organizationId) || isAdmin();
      allow create: if (isOrganizationAdmin(request.resource.data.organizationId)
        && isVerifiedOrganization(request.resource.data.organizationId)) || isAdmin();
      allow update: if (isOrganizationAdmin(resource.data.organizationId)
        && isVerifiedOrganization(resource.data.organizationId)
        && request.resource.data.organizationId == resource.data.organizationId) || isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if hasRole("volunteer") && request.resource.data.userId == request.auth.uid
        && applicationId == request.resource.data.opportunityId + "_" + request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.userEmail == request.auth.token.email
        && publicOpportunity(get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data)
        && request.resource.data.organizationId == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.organizationId;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOrganizationAdmin(resource.data.organizationId) || isAdmin());
      allow update: if isAdmin() || (
        isOrganizationAdmin(resource.data.organizationId)
        && (
          (
            resource.data.status == "pending"
            && request.resource.data.status in ["accepted", "rejected"]
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          )
          || (
            resource.data.status == "accepted"
            && request.resource.data.status == "accepted"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["completedAt", "absentAt", "updatedAt"])
          )
        )
      );
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.read == false
        && (
          (request.resource.data.type == "application_received"
            && hasRole("volunteer")
            && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.userId == request.auth.uid
            && request.resource.data.recipientId == getAfter(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.organizationId)
          ||
          (request.resource.data.type in ["application_accepted", "application_rejected"]
            && isOrganizationAdmin(getAfter(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.organizationId)
            && request.resource.data.recipientId == getAfter(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.userId)
          ||
          (request.resource.data.type == "proposal_received"
            && isOrganizationAdmin(getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.organizationId)
            && request.resource.data.recipientId == getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.userId)
          ||
          (request.resource.data.type in ["proposal_accepted", "proposal_rejected"]
            && hasRole("volunteer")
            && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.userId == request.auth.uid
            && request.resource.data.recipientId == getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.organizationId)
          ||
          (request.resource.data.type == "feedback_warning"
            && isAdmin()
            && request.resource.data.recipientId == getAfter(/databases/$(database)/documents/feedback/$(request.resource.data.feedbackId)).data.volunteerId)
          ||
          (request.resource.data.type == "absence_reported"
            && isOrganizationAdmin(getAfter(/databases/$(database)/documents/absenceReports/$(request.resource.data.absenceReportId)).data.organizationId)
            && request.resource.data.recipientId == getAfter(/databases/$(database)/documents/absenceReports/$(request.resource.data.absenceReportId)).data.volunteerId)
          ||
          (request.resource.data.type == "absence_resolved"
            && isAdmin()
            && request.resource.data.recipientId == getAfter(/databases/$(database)/documents/absenceReports/$(request.resource.data.absenceReportId)).data.volunteerId)
          ||
          (request.resource.data.type in ["account_suspended", "account_restored"]
            && isAdmin()
            && request.resource.data.moderationTargetId == request.resource.data.recipientId
            && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId)))
        );
      allow update: if owns(resource.data.recipientId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"])
        && request.resource.data.read == true;
      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow create: if isOrganizationAdmin(request.resource.data.organizationId)
        && request.resource.data.status == "pending"
        && isVerifiedOrganization(request.resource.data.organizationId)
        && publicOpportunity(get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data)
        && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.organizationId == request.resource.data.organizationId;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOrganizationAdmin(resource.data.organizationId) || isAdmin());
      allow update: if (
        hasRole("volunteer") && owns(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "respondedAt"])
          && resource.data.status == "pending"
          && request.resource.data.status in ["accepted", "rejected"]
      ) || (
        isOrganizationAdmin(resource.data.organizationId)
          && resource.data.status == "accepted"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["completedAt", "absentAt"])
      );
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow create: if (
        isOrganizationAdmin(request.resource.data.organizationId)
          && request.resource.data.source == "application"
          && request.resource.data.status == "confirmed"
          && matchId == request.resource.data.opportunityId + "_" + request.resource.data.userId
          && getAfter(/databases/$(database)/documents/applications/$(matchId)).data.status == "accepted"
          && getAfter(/databases/$(database)/documents/applications/$(matchId)).data.organizationId == request.resource.data.organizationId
          && getAfter(/databases/$(database)/documents/applications/$(matchId)).data.opportunityId == request.resource.data.opportunityId
          && getAfter(/databases/$(database)/documents/applications/$(matchId)).data.userId == request.resource.data.userId
      ) || (
          hasRole("volunteer") && owns(request.resource.data.userId)
          && request.resource.data.source == "invitation"
          && request.resource.data.status == "confirmed"
          && matchId == "invitation_" + request.resource.data.invitationId
          && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.status == "accepted"
          && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.organizationId == request.resource.data.organizationId
          && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.opportunityId == request.resource.data.opportunityId
      );
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOrganizationAdmin(resource.data.organizationId) || isAdmin());
      allow update: if isAdmin() || (
        isOrganizationAdmin(resource.data.organizationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "completedAt", "absentAt"])
        && (
          (resource.data.status == "confirmed" && request.resource.data.status in ["completed", "absence_pending_review"])
          || (request.resource.data.status == resource.data.status)
        )
      );
    }

    match /participations/{participationId} {
      allow create: if isOrganizationAdmin(request.resource.data.organizationId)
        && participationId == request.resource.data.matchId
        && getAfter(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status in ["completed", "absence_pending_review"]
        && getAfter(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.userId == request.resource.data.userId
        && getAfter(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.organizationId == request.resource.data.organizationId
        && getAfter(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.opportunityId == request.resource.data.opportunityId;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOrganizationAdmin(resource.data.organizationId) || isAdmin());
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedAt", "reviewedBy"]);
    }

    match /absenceReports/{reportId} {
      allow create: if isOrganizationAdmin(request.resource.data.organizationId)
        && reportId == request.resource.data.matchId
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == "pending_review"
        && getAfter(/databases/$(database)/documents/participations/$(request.resource.data.matchId)).data.organizationId == request.resource.data.organizationId
        && getAfter(/databases/$(database)/documents/participations/$(request.resource.data.matchId)).data.userId == request.resource.data.volunteerId
        && getAfter(/databases/$(database)/documents/participations/$(request.resource.data.matchId)).data.opportunityId == request.resource.data.opportunityId;
      allow read: if signedIn() && (resource.data.volunteerId == request.auth.uid || isOrganizationAdmin(resource.data.organizationId) || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedAt", "reviewedBy", "reviewReason"])
        && request.resource.data.status in ["confirmed", "dismissed"];
    }

    match /feedback/{feedbackId} {
      allow create: if isOrganizationAdmin(request.resource.data.organizationId)
        && feedbackId == request.resource.data.matchId
        && getAfter(/databases/$(database)/documents/participations/$(request.resource.data.matchId)).data.status == "completed"
        && getAfter(/databases/$(database)/documents/participations/$(request.resource.data.matchId)).data.organizationId == request.resource.data.organizationId
        && getAfter(/databases/$(database)/documents/participations/$(request.resource.data.matchId)).data.userId == request.resource.data.volunteerId
        && getAfter(/databases/$(database)/documents/participations/$(request.resource.data.matchId)).data.opportunityId == request.resource.data.opportunityId
        && request.resource.data.assessment in ["positive", "needs_improvement"]
        && request.resource.data.submittedByEmail == request.auth.token.email
        && request.resource.data.tasks is list
        && request.resource.data.tasks.size() > 0
        && request.resource.data.skills is list
        && request.resource.data.skills.size() <= 3
        && request.resource.data.skills.hasOnly([
          "Arte y creatividad", "Educación y acompañamiento", "Naturaleza y ambiente",
          "Cocina y alimentación", "Construcción y reparación", "Organización y logística",
          "Tecnología y comunicación", "Deporte, juego y recreación"
        ])
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 600
        && (
          (request.resource.data.assessment == "positive" && request.resource.data.status == "recorded")
          || (request.resource.data.assessment == "needs_improvement" && request.resource.data.status == "pending_review" && request.resource.data.details.size() >= 15)
        );
      allow read: if signedIn() && (resource.data.volunteerId == request.auth.uid || isOrganizationAdmin(resource.data.organizationId) || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "moderationReason", "moderatedBy", "moderatedAt"])
        && request.resource.data.status in ["approved", "dismissed"];
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create: if hasRole("volunteer")
        && reviewId == request.resource.data.applicationId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 10
        && request.resource.data.comment.size() <= 600
        && (request.resource.data.authorName == "Voluntario anónimo" || request.resource.data.authorName == request.auth.token.name)
        && request.resource.data.status == "published"
        && get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.userId == request.auth.uid
        && request.resource.data.opportunityId == get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.opportunityId
        && request.resource.data.organizationId == get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.organizationId
        && get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.completedAt != null;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status", "moderationReason", "moderatedBy", "moderatedAt"
      ]);
      allow delete: if false;
    }

    match /reviewReports/{reportId} {
      allow create: if activeUser()
        && reportId == request.resource.data.reviewId + "_" + request.auth.uid
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.reason.size() <= 400
        && request.resource.data.status == "pending"
        && exists(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId));
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status", "resolvedBy", "resolvedAt"
      ]);
      allow delete: if false;
    }

    match /reviewPhotos/{reviewId} {
      allow read: if resource.data.status == "approved" || owns(resource.data.userId) || isAdmin();
      allow create: if hasRole("volunteer")
        && reviewId == request.resource.data.reviewId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.imageDataUrl is string
        && request.resource.data.imageDataUrl.size() <= 750000
        && request.resource.data.imageDataUrl.matches('data:image/jpeg;base64,.*')
        && existsAfter(/databases/$(database)/documents/reviews/$(reviewId));
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status", "moderationReason", "moderatedBy", "moderatedAt"
      ]);
      allow delete: if false;
    }

    match /adminActions/{actionId} {
      allow create: if isAdmin()
        && request.resource.data.actorId == request.auth.uid
        && (!request.resource.data.keys().hasAny(["actorEmail"]) || request.resource.data.actorEmail == request.auth.token.email);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Solo administración puede poner correos en la cola; el contenido no es visible desde la app.
    match /mail/{messageId} {
      allow create: if isAdmin()
        && request.resource.data.to is list
        && request.resource.data.to.size() == 1;
      allow read, update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
