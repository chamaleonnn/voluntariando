rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function userRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }
    function isAdmin() { return userRole() == "admin"; }
    function isOrganizationAdmin(organizationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizationMembers/$(organizationId + "_" + request.auth.uid))
        && get(/databases/$(database)/documents/organizationMembers/$(organizationId + "_" + request.auth.uid)).data.role == "owner";
    }
    function publicOpportunity(data) { return data.status == "published" && data.visibility == "public"; }

    match /users/{userId} {
      allow create: if owns(userId) && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "active"
        && (
          request.resource.data.role in ["volunteer", "organization"]
          || (request.resource.data.role == "admin" && request.auth.token.email == "leybatao014@gmail.com")
        );
      allow read: if owns(userId) || isAdmin();
      allow update: if (
        owns(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName", "lastLoginAt"])
      ) || (
        owns(userId)
        && request.auth.token.email == "leybatao014@gmail.com"
        && request.resource.data.role == "admin"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role", "lastLoginAt"])
      ) || (
        isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName", "role", "status", "suspensionReason", "suspendedUntil", "moderatedBy", "updatedAt"
        ])
      );
    }

    match /volunteerProfiles/{userId} {
      allow create: if owns(userId);
      allow read: if owns(userId) || userRole() == "organization" || isAdmin();
      allow update: if (
        owns(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name", "initials", "location", "bio", "interests", "declaredSkills", "availability", "socialLinks", "featuredMedals", "updatedAt"
        ])
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "verifiedSkills", "experiences", "completedExperiences", "lastExperienceMatchId", "updatedAt"
        ])
        && getAfter(/databases/$(database)/documents/matches/$(request.resource.data.lastExperienceMatchId)).data.userId == userId
        && getAfter(/databases/$(database)/documents/matches/$(request.resource.data.lastExperienceMatchId)).data.status == "completed"
        && isOrganizationAdmin(getAfter(/databases/$(database)/documents/matches/$(request.resource.data.lastExperienceMatchId)).data.organizationId)
      );
    }

    match /organizations/{organizationId} {
      allow read: if resource.data.status == "verified" || owns(resource.data.ownerId) || isOrganizationAdmin(organizationId) || isAdmin();
      allow create: if owns(organizationId) && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == "verified";
      allow update: if isAdmin() || (owns(resource.data.ownerId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "name", "province", "location", "contact", "description", "updatedAt"
      ]));
    }

    match /organizationMembers/{membershipId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOrganizationAdmin(resource.data.organizationId));
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == "owner"
        && membershipId == request.resource.data.organizationId + "_" + request.auth.uid;
    }

    match /opportunities/{opportunityId} {
      allow read: if publicOpportunity(resource.data) || isOrganizationAdmin(resource.data.organizationId) || isAdmin();
      allow create: if isOrganizationAdmin(request.resource.data.organizationId) || isAdmin();
      allow update: if isOrganizationAdmin(resource.data.organizationId) || isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && applicationId == request.resource.data.opportunityId + "_" + request.auth.uid
        && request.resource.data.status == "pending"
        && publicOpportunity(get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOrganizationAdmin(resource.data.organizationId) || isAdmin());
      allow update: if isOrganizationAdmin(resource.data.organizationId) || isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.read == false
        && (
          (request.resource.data.type == "application_received"
            && getAfter(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.userId == request.auth.uid
            && request.resource.data.recipientId == getAfter(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.organizationId)
          ||
          (request.resource.data.type in ["application_accepted", "application_rejected"]
            && isOrganizationAdmin(getAfter(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.organizationId)
            && request.resource.data.recipientId == getAfter(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.userId)
        );
      allow update: if owns(resource.data.recipientId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"])
        && request.resource.data.read == true;
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow create: if isOrganizationAdmin(request.resource.data.organizationId);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOrganizationAdmin(resource.data.organizationId) || isAdmin());
      allow update: if isOrganizationAdmin(resource.data.organizationId) || isAdmin();
    }

    match /participations/{participationId} {
      allow create: if isOrganizationAdmin(request.resource.data.organizationId)
        && getAfter(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status == "completed"
        && getAfter(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.userId == request.resource.data.userId;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOrganizationAdmin(resource.data.organizationId) || isAdmin());
    }

    match /feedback/{feedbackId} {
      allow create: if isOrganizationAdmin(request.resource.data.organizationId)
        && existsAfter(/databases/$(database)/documents/participations/$(request.resource.data.matchId));
      allow read: if signedIn() && (resource.data.volunteerId == request.auth.uid || isOrganizationAdmin(resource.data.organizationId) || isAdmin());
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create: if signedIn()
        && reviewId == request.resource.data.applicationId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 10
        && request.resource.data.comment.size() <= 600
        && (request.resource.data.authorName == "Voluntario anónimo" || request.resource.data.authorName == request.auth.token.name)
        && request.resource.data.status == "published"
        && get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.userId == request.auth.uid
        && request.resource.data.opportunityId == get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.opportunityId
        && request.resource.data.organizationId == get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.organizationId
        && get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.completedAt != null;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status", "moderationReason", "moderatedBy", "moderatedAt"
      ]);
      allow delete: if false;
    }

    match /reviewReports/{reportId} {
      allow create: if signedIn()
        && reportId == request.resource.data.reviewId + "_" + request.auth.uid
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.reason.size() <= 400
        && request.resource.data.status == "pending"
        && exists(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId));
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status", "resolvedBy", "resolvedAt"
      ]);
      allow delete: if false;
    }

    match /reviewPhotos/{reviewId} {
      allow read: if resource.data.status == "approved" || owns(resource.data.userId) || isAdmin();
      allow create: if signedIn()
        && reviewId == request.resource.data.reviewId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.imageDataUrl is string
        && request.resource.data.imageDataUrl.size() <= 750000
        && request.resource.data.imageDataUrl.matches('data:image/jpeg;base64,.*')
        && existsAfter(/databases/$(database)/documents/reviews/$(reviewId));
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status", "moderationReason", "moderatedBy", "moderatedAt"
      ]);
      allow delete: if false;
    }

    match /adminActions/{actionId} {
      allow create, read: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
