{
  "name": "voluntariando",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:recommendations": "node --experimental-strip-types --test scripts/recommendations.test.mjs",
    "test:via": "node --experimental-strip-types --test scripts/via-tutorial.test.mjs",
    "test:rules": "node --experimental-strip-types --test scripts/firestore-rules.test.mjs",
    "verify": "npm run lint && npm run build && npm run test:recommendations && npm run test:via && npm --prefix functions run check"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
